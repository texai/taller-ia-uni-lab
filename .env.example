# Copia este archivo a .env y completa SOLO la linea de tu proveedor.
#
#   cp .env.example .env
#
# El agente es agnostico al proveedor. Elige uno y pon su llave.

# google | groq | openai | anthropic | ollama | mock
PROVEEDOR_LLM=google

# Si no estas seguro, deja el modelo por defecto de tu proveedor:
#   google     -> gemini-2.0-flash          (llave gratuita en aistudio.google.com)
#   groq       -> llama-3.3-70b-versatile   (llave gratuita en console.groq.com)
#   openai     -> gpt-4o-mini               (de pago)
#   anthropic  -> claude-haiku-4-5             (de pago)
#   ollama     -> qwen2.5:3b-instruct       (local, sin llave)
MODELO_LLM=gemini-2.0-flash

GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Solo si PROVEEDOR_LLM=ollama
URL_OLLAMA=http://ollama:11434

# Permiso para que el agente ejecute lo que recomienda (reentrenar de verdad).
# Apagado por omision: un agente que reentrena solo la primera vez que alguien
# lo corre es una sorpresa desagradable.
EJECUTAR_ACCIONES=0
